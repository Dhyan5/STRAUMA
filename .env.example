# ---------------------------------------------------------------------------
# NHAA 14566 Stress & Trauma Assessment Module - example environment
# Copy to `.env` for local development. NEVER commit a filled-in .env.
# ---------------------------------------------------------------------------

# --- Backend ---
# SQLite works with zero configuration. For the Docker/Postgres path use:
#   postgresql+psycopg://nhaa:nhaa@localhost:5432/nhaa
DATABASE_URL=sqlite:///./app.db

# Queue/session store. Leave empty to fall back to an in-process store
# (a warning is logged on startup; the prototype stays fully functional).
REDIS_URL=

# CHANGE THIS before any shared deployment. Generated with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-generate-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional Fernet key used to encrypt separately-collected identity fields at
# rest. Generate with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty in the demo: identity fields are simply not collected.
IDENTITY_ENCRYPTION_KEY=

# Raw text/audio retention in days (DPDP Act 2023 - storage limitation).
# A scheduled job should purge Interaction.raw_text / transcribed_text and
# audio files older than this. 0 disables automatic expiry (demo default).
DATA_RETENTION_DAYS=0

# --- Analysis engines ---
# Set to "ml" to attempt loading the multilingual sentiment model via
# HuggingFace transformers. If loading fails the engine automatically falls
# back to "heuristic" and every response reports method="heuristic".
SENTIMENT_BACKEND=auto          # auto | ml | heuristic
SENTIMENT_MODEL=cardiff/nlp/xlm-ro-base-sentiment-multilingual-2023-hrul
AUDIO_BACKEND=auto              # auto | librosa | heuristic
VOCAL_STRESS_MODE=heuristic-demo   # heuristic-demo | ml-model (see README)

# --- Translation (Bhashini / IndicTrans2 adapter) ---
# See backend/nlp/translator.py. Stub adapter is used unless a provider is set.
TRANSLATION_PROVIDER=stub
BHASHINI_API_KEY=
BHASHINI_API_URL=

# --- Notification gateway (mock by default) ---
# "mock" logs to the notification_outbox table only. Set to a real adapter
# name ONLY after procurement of an empanelled SMS gateway.
NOTIFICATION_PROVIDER=mock

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=NHAA 14566 Support Portal
